<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="StaticVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="CatchParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LambdaParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="allowOneCharVarInForLoop" value="true"/>
        </module>
        <module name="LocalFinalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!--
          MatchXpath is syntax-only. It can flag regex convenience methods but cannot resolve whether
          a receiver is String, Pattern, or Matcher. Keep the query set intentionally narrow.
        -->
        <module name="MatchXpath">
            <property name="query"
                      value="//METHOD_CALL[./DOT[./IDENT[1][@text='Pattern'] and ./IDENT[last()][@text='matches']]]"/>
            <message key="matchxpath.match"
                     value="Do not use Pattern.matches(...); precompile a Pattern and reuse it."/>
        </module>
        <module name="MatchXpath">
            <property name="query"
                      value="//METHOD_CALL[./DOT/IDENT[last()][@text='split']]"/>
            <message key="matchxpath.match"
                     value="Do not call split(...) with an inline regex. Precompile a Pattern and reuse it. Add a targeted suppression if this is Pattern.split(...)."/>
        </module>
        <module name="MatchXpath">
            <property name="query"
                      value="//METHOD_CALL[./DOT/IDENT[last()][@text='replaceAll']]"/>
            <message key="matchxpath.match"
                     value="Do not call replaceAll(...) with an inline regex. Precompile a Pattern and reuse it. Add a targeted suppression if this is Matcher.replaceAll(...)."/>
        </module>
        <module name="MatchXpath">
            <property name="query"
                      value="//METHOD_CALL[./DOT/IDENT[last()][@text='replaceFirst']]"/>
            <message key="matchxpath.match"
                     value="Do not call replaceFirst(...) with an inline regex. Precompile a Pattern and reuse it. Add a targeted suppression if this is Matcher.replaceFirst(...)."/>
        </module>
    </module>
</module>
